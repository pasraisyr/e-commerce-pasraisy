# ================================================================
# DATABASE (PostgreSQL / Neon)
# ================================================================
DATABASE_URL=postgresql://username:password@ep-sample-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ================================================================
# SERVER CONFIG
# ================================================================
PORT=8080
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
JWT_SECRET=super-secret-ecommerce-jwt-key-change-in-production

# ================================================================
# TOYYIBPAY PAYMENT GATEWAY (Malaysia FPX & Card)
# Daftar di: https://toyyibpay.com atau https://dev.toyyibpay.com (Sandbox)
# ================================================================
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_SANDBOX=true

# ================================================================
# EASYPARCEL SHIPPING (Kiraan kadar pos & cetak AWB)
# Daftar di: https://easyparcel.com/my/ atau https://demo.easyparcel.com/
# ================================================================
EASYPARCEL_API_KEY=
EASYPARCEL_SANDBOX=true
